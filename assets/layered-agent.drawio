<mxGraphModel adaptiveColors="auto" page="0" background="#f5f5f0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="user" value="&lt;b&gt;用户 / Web 工作台&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;输入视频与指令 · 核对并采用布局&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bb7a8;fontColor=#173d31;fontFamily=Microsoft YaHei;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="350" height="105" as="geometry" /></mxCell><mxCell id="pi" value="&lt;b&gt;Pi 主控 · ReAct 式循环&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;观察图像与状态 → 选择工具 → 读取结果&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6edba;strokeColor=#9bb7a8;fontColor=#173d31;fontFamily=Microsoft YaHei;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="480" y="40" width="540" height="110" as="geometry" /></mxCell><mxCell id="host" value="&lt;b&gt;Python 工具宿主&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Schema 校验 · 调用去重 · 取消与执行回执&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f0e4;strokeColor=#9bb7a8;fontColor=#173d31;fontFamily=Microsoft YaHei;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="480" y="245" width="540" height="110" as="geometry" /></mxCell><mxCell id="vipe" value="&lt;b&gt;ViPE 几何工具&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;estimate_geometry&lt;br&gt;密集 RGB → 相机 / 深度&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bb7a8;fontColor=#173d31;fontFamily=Microsoft YaHei;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="285" height="115" as="geometry" /></mxCell><mxCell id="sam" value="&lt;b&gt;SAM 实例工具&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;segment_instances&lt;br&gt;prior 提示 → track / mask&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9bb7a8;fontColor=#173d31;fontFamily=Microso